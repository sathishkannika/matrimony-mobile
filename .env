# Local development — points at the backend running via `mvnw spring-boot:run` on your machine.
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost (NOT 'localhost' —
# that would resolve to the emulator itself). iOS Simulator can use localhost directly; if you
# switch this file per-platform, keep both noted here rather than silently breaking one of them.
API_BASE_URL=http://10.0.2.2:8080
